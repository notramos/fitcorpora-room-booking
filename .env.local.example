AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Microsoft Teams silent SSO (see README "Integrasi Microsoft Teams")
# Application ID URI from Azure AD App Registration > Expose an API, e.g. api://booking.example.com/<AZURE_AD_CLIENT_ID>
NEXT_PUBLIC_TEAMS_APP_ID_URI=

# Google Sheets — data store (see README "Setup Google Sheets")
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the \n as literal two-character sequences, not real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
