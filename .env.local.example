AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Comma-separated list of admin emails (case-insensitive). These accounts
# see /admin/* and can manage rooms + approve bookings.
ADMIN_EMAILS=

# Microsoft Teams silent SSO (see README "Integrasi Microsoft Teams")
# Application ID URI from Azure AD App Registration > Expose an API, e.g. api://booking.example.com/<AZURE_AD_CLIENT_ID>
NEXT_PUBLIC_TEAMS_APP_ID_URI=

# PostgreSQL — data store (see README "Setup PostgreSQL"). The app creates
# its own schema (tables `rooms`, `bookings`) on first connect and seeds 3
# example rooms if `rooms` is empty.
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
# Set to "true" for a managed Postgres that requires TLS (Neon, Supabase,
# RDS, …). Leave unset for a local or docker Postgres.
DATABASE_SSL=
